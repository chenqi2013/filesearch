{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地知搜",
  "version": "0.1.2",
  "identifier": "com.localfind.desktop",
  "build": {
    "beforeDevCommand": "pnpm prepare:sidecar && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm prepare:sidecar:release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "本地知搜",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 620,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:47653; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/search-core"],
    "resources": {
      "binaries/onnxruntime.dll": "onnxruntime.dll",
      "binaries/vcruntime140.dll": "vcruntime140.dll",
      "binaries/vcruntime140_1.dll": "vcruntime140_1.dll",
      "binaries/msvcp140.dll": "msvcp140.dll",
      "binaries/msvcp140_1.dll": "msvcp140_1.dll",
      "../assets/models": "models"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}

